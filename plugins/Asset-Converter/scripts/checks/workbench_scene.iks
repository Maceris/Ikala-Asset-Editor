// A check of the workbench's 3D viewer, which draws the open scene into a preview view of its
// own. Run it at startup with
//   -Dikala.test.script=<this file> -Dikala.test.scriptArgs=<a folder for the PNG files>
// It opens the sphere, captures it, turns the camera and captures it again, captures it under
// each lighting preset and in each view mode, supersampled, and with its overlays, opens the cube
// and captures that, then opens the particle stage and
// captures it twice, a second apart. Each step is logged as "Script: ...".
Object t = ui.test();
converter.openWorkbench("preview:sphere");
await(t.frames(60));
converter.captureScene(args, "sphere.png");
await(t.frames(40));
converter.placeCamera(2.5, 1.5, 2.5, 0.4, -0.785);
await(t.frames(10));
converter.captureScene(args, "sphere-turned.png");
await(t.frames(40));
converter.lightScene("Overcast");
converter.captureScene(args, "light-overcast.png");
await(t.frames(40));
converter.lightScene("Sunset");
converter.captureScene(args, "light-sunset.png");
await(t.frames(40));
converter.lightScene("Torch cave");
converter.captureScene(args, "light-torch-cave.png");
await(t.frames(40));
converter.lightScene("Colored lights");
converter.captureScene(args, "light-colored-lights.png");
await(t.frames(40));
converter.lightScene("Night");
converter.captureScene(args, "light-night.png");
await(t.frames(40));
converter.lightScene("Noon");
converter.captureScene(args, "light-noon.png");
await(t.frames(40));
converter.showScene("Base color");
converter.captureScene(args, "view-base-color.png");
await(t.frames(40));
converter.showScene("Normals");
converter.captureScene(args, "view-normals.png");
await(t.frames(40));
converter.showScene("Roughness");
converter.captureScene(args, "view-roughness.png");
await(t.frames(40));
converter.showScene("Metallic");
converter.captureScene(args, "view-metallic.png");
await(t.frames(40));
converter.showScene("Far flat color");
converter.captureScene(args, "view-far-color.png");
await(t.frames(40));
converter.showScene("Lit");
converter.supersampleScene(true);
converter.captureScene(args, "supersampled.png");
await(t.frames(40));
converter.supersampleScene(false);
converter.overlayScene("grid", true);
converter.overlayScene("bounds", true);
converter.overlayScene("offgrid", true);
converter.overlayScene("normals", true);
await(t.frames(5));
converter.captureScene(args, "overlays.png");
await(t.frames(40));
converter.overlayScene("grid", false);
converter.overlayScene("bounds", false);
converter.overlayScene("offgrid", false);
converter.overlayScene("normals", false);
converter.openWorkbench("preview:cube");
await(t.frames(60));
converter.captureScene(args, "cube.png");
await(t.frames(40));
converter.openWorkbench("../Lotomation/art/render_materials/block/bronze.material.yml");
await(t.frames(60));
converter.captureScene(args, "material-file.png");
await(t.frames(40));
converter.openWorkbench("../Lotomation/plugins/Lotomation/data/models/block/cube_bottom_top.ika");
await(t.frames(30));
converter.containerInThreeD("mesh");
await(t.frames(60));
converter.captureScene(args, "container-mesh.png");
await(t.frames(40));
converter.openWorkbench("../Lotomation/plugins/Lotomation/data/render_materials/block/steel.ika");
await(t.frames(30));
converter.containerInThreeD("material");
await(t.frames(60));
converter.captureScene(args, "container-material.png");
await(t.frames(40));
converter.openWorkbench("../Lotomation/plugins/Lotomation/data/looks/block/grass.kvt");
await(t.frames(90));
converter.captureScene(args, "look-block.png");
await(t.frames(40));
converter.pickScene("Wall");
await(t.frames(90));
converter.captureScene(args, "look-wall.png");
await(t.frames(40));
converter.pickScene("Floor");
await(t.frames(90));
converter.captureScene(args, "look-floor.png");
await(t.frames(40));
converter.pickScene("Neighbors");
await(t.frames(90));
converter.captureScene(args, "look-neighbors.png");
await(t.frames(40));
converter.pickScene("Particle stage");
await(t.frames(90));
converter.captureScene(args, "particles.png");
await(t.frames(60));
converter.captureScene(args, "particles-later.png");
await(t.frames(40));
converter.log("Scene checked");
