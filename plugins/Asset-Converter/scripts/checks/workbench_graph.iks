// A check of the workbench's graph panel, on texture graph nodes. Run it at startup with
//   -Dikala.test.script=<this file> -Dikala.test.scriptArgs=<a folder for the saved graph>
// It builds a small texture graph through the editor's own edits, links a texture into a color
// (which adds a Sample node), undoes and redoes, duplicates and deletes, saves the graph and opens
// it again. Then it tidies the graph: a reroute, a named reroute pair, a comment frame, a collapsed
// node, hidden pins, a comment, aligning and straightening, upstream and downstream selection,
// removing unused nodes and finding, saves that and opens it again. Then it drives the canvas with
// real mouse and key input at the points the editor names: the node and frame menus, the comment,
// frame and find popups, an error's tooltip, placing a node with a held key, a reroute by
// double-click, dragging a frame and the minimap. It bakes the graph into the folder, then checks
// the editing features: swatches, showing a node, Measure, pin ranges, the seed grid, parameters
// and a switch, and the Output on the 3D shape; it saves and reopens that graph. Each
// step is logged as "Script: ...".
Object t = ui.test();
converter.openWorkbench(".");
await(t.frames(30));
await(t.click("*//reset-layout"));
await(t.frames(10));
converter.graph("swatches off");
converter.graph("new");
converter.graph("add noise/cells 0 0");
converter.graph("add input/constant 0 120");
converter.graph("set constant1 value 1");
converter.graph("add math/multiply 240 40");
converter.graph("add input/color 240 200");
converter.graph("add input/color 240 320");
converter.graph("add ops/blend 480 200");
converter.graph("add output/all 720 200");
converter.graph("set color1 color #668033");
converter.graph("set color2 color #6b4a2e");
converter.graph("link cells1.value multiply1.a");
converter.graph("link constant1.value multiply1.b");
converter.graph("link color1.color blend1.base");
converter.graph("link color2.color blend1.top");
converter.graph("link multiply1.result blend1.mask");
converter.graph("link blend1.color all1.color");
converter.graph("log");
converter.graph("add input/image 480 440");
converter.graph("link image1.texture all1.emissive");
converter.graph("log");
converter.graph("undo");
converter.graph("log");
converter.graph("redo");
converter.graph("undo");
converter.graph("select constant1 multiply1");
converter.graph("duplicate");
converter.graph("log");
converter.graph("delete");
converter.graph("log");
converter.graphSave(args, "demo.texgraph.yml");
await(t.frames(10));
converter.graphOpen(args, "demo.texgraph.yml");
await(t.frames(30));
converter.graph("log");
converter.graph("select multiply1");
await(t.frames(30));
converter.graph("reroute blend1.color all1.color 680 260");
converter.graph("add graph/send 480 40");
converter.graph("add graph/receive 320 360");
converter.graph("link multiply1.result send1.in");
converter.graph("set send1 name mask");
converter.graph("set receive1 name mask");
converter.graph("link receive1.out blend1.mask");
converter.graph("add input/constant 900 600");
converter.graph("log");
await(t.frames(5));
converter.graph("select color1 color2");
converter.graph("frame Colors");
converter.graph("collapse color2");
converter.graph("hide blend1");
converter.graph("comment all1 The final color");
converter.graph("straighten all1");
converter.graph("upstream blend1");
converter.graph("downstream cells1");
converter.graph("find final");
converter.graph("unused");
converter.graph("log");
converter.graphSave(args, "tidy.texgraph.yml");
await(t.frames(10));
converter.graphOpen(args, "tidy.texgraph.yml");
await(t.frames(30));
converter.graph("log");
converter.graph("select");
await(t.frames(30));
await(t.mouseClickAt("*//graph-canvas", "node color1", "right"));
await(t.clickItem("*", "Collapse"));
await(t.frames(5));
converter.graph("describe color1");
await(t.mouseClickAt("*//graph-canvas", "node blend1", "right"));
await(t.clickItem("*", "Comment..."));
await(t.typeItem("*", "##comment", "Mixes the colors", true));
await(t.frames(5));
converter.graph("describe blend1");
await(t.mouseClickAt("*//graph-canvas", "frame frame1", "right"));
await(t.clickItem("*", "Edit..."));
await(t.typeItem("*", "##frame", "Base colors", true));
await(t.frames(5));
converter.graph("describe frame1");
await(t.mouseDragAt("*//graph-canvas", "frame frame1", "at 296 -40"));
await(t.frames(5));
converter.graph("describe frame1");
converter.graph("view 100 300 1");
await(t.frames(3));
await(t.mouseMoveTo("*//graph-canvas", "at 100 300"));
await(t.keyDown("a"));
await(t.mouseClickAt("*//graph-canvas", "at 100 300"));
await(t.keyUp("a"));
await(t.frames(5));
converter.graph("describe add1");
converter.graph("add input/image 300 700");
await(t.frames(5));
converter.graph("focus image1");
await(t.frames(5));
await(t.mouseMoveTo("*//graph-canvas", "node image1"));
await(t.waitForTooltip("Choose an image file"));
converter.log("Graph tooltip shown");
converter.graph("focus blend1");
await(t.frames(3));
await(t.mouseDoubleClickAt("*//graph-canvas", "link color1.color blend1.base"));
await(t.frames(5));
converter.graph("log");
converter.graph("focus all1");
await(t.frames(3));
await(t.mouseMoveTo("*//graph-canvas", "node all1"));
await(t.key("ctrl+f"));
await(t.typeItem("*", "##find", "Output", true));
await(t.frames(5));
converter.graph("describe all1");
await(t.mouseClickAt("*//graph-canvas", "minimap 0.1 0.1"));
await(t.frames(5));
converter.graph("log");
converter.graph("setting data .");
converter.graph("setting texture block/check");
converter.graphSave(args, "tidy.texgraph.yml");
await(t.frames(5));
converter.graph("bake");
await(t.frames(30));
// Editing: swatches, showing a node from its menu, Measure, a pin's range, the seed grid, parameters,
// a switch, and the Output's maps in the Viewer and on the 3D view's shape
converter.graphOpen(args, "tidy.texgraph.yml");
await(t.frames(10));
converter.graph("swatches on");
await(t.frames(5));
converter.graph("previews");
converter.graph("focus blend1");
await(t.frames(3));
await(t.mouseClickAt("*//graph-canvas", "node blend1", "right"));
await(t.clickItem("*", "Show in the Viewer"));
await(t.frames(10));
converter.graph("previews");
converter.graph("focus cells1");
await(t.frames(3));
await(t.mouseClickAt("*//graph-canvas", "node cells1", "right"));
await(t.clickItem("*", "Measure"));
await(t.frames(5));
converter.graph("measure cells1");
await(t.mouseMoveTo("*//graph-canvas", "out cells1 value"));
await(t.waitForTooltip("value (scalar)"));
converter.graph("pin cells1 value out");
converter.graph("seeds on");
await(t.frames(10));
converter.graph("seeds pick 4");
converter.graph("seeds off");
converter.graph("param add wear scalar");
converter.graph("param set wear 0.75");
converter.graph("param add useTint switch");
converter.graph("add parameter/scalar 0 760");
converter.graph("set scalar1 name wear");
converter.graph("add switch/color 480 760");
converter.graph("set color3 name useTint");
converter.graph("link color1.color color3.on");
converter.graph("link color2.color color3.off");
await(t.frames(10));
converter.graph("describe scalar1");
converter.graph("describe color3");
converter.graph("pin color3 result out");
converter.graph("display all1");
converter.graph("map normal");
converter.graph("shape on");
await(t.frames(60));
converter.graph("previews");
converter.graphSave(args, "params.texgraph.yml");
await(t.frames(5));
converter.graphOpen(args, "params.texgraph.yml");
await(t.frames(30));
converter.graph("param set wear 0.5");
converter.graph("log");
converter.log("Graph checked");
