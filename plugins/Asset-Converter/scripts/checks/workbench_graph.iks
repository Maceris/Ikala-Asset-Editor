// A check of the workbench's graph panel, on the demo math and color nodes. Run it at startup with
//   -Dikala.test.script=<this file> -Dikala.test.scriptArgs=<a folder for the saved graph>
// It builds a small graph through the editor's own edits, links a scalar into a color (which adds
// a Gray conversion node), undoes and redoes, duplicates and deletes, saves the graph and opens it
// again. Then it tidies the graph: a reroute, a named reroute pair, a comment frame, a collapsed
// node, hidden pins, a comment, aligning and straightening, upstream and downstream selection,
// removing unused nodes and finding, saves that and opens it again. Last it drives the canvas with
// real mouse and key input at the points the editor names: the node and frame menus, the comment,
// frame and find popups, an error's tooltip, placing a node with a held key, a reroute by
// double-click, dragging a frame and the minimap. Each step is logged as "Script: ...".
Object t = ui.test();
converter.openWorkbench(".");
await(t.frames(30));
converter.graph("new");
converter.graph("add math/checker 0 0");
converter.graph("add math/constant 0 120");
converter.graph("add math/multiply 240 40");
converter.graph("add math/color 240 200");
converter.graph("add math/color 240 320");
converter.graph("add math/lerp 480 200");
converter.graph("add out/output 720 200");
converter.graph("set color1 g 0.4");
converter.graph("set color2 r 0.2");
converter.graph("link checker1.mask multiply1.a");
converter.graph("link constant1.value multiply1.b");
converter.graph("link color1.color lerp1.a");
converter.graph("link color2.color lerp1.b");
converter.graph("link multiply1.result lerp1.t");
converter.graph("link lerp1.color output1.color");
converter.graph("log");
converter.graph("link multiply1.result output1.color");
converter.graph("log");
converter.graph("undo");
converter.graph("log");
converter.graph("redo");
converter.graph("undo");
converter.graph("select constant1 multiply1");
converter.graph("duplicate");
converter.graph("log");
converter.graph("delete");
converter.graph("log");
converter.graphSave(args, "demo.graph.yml");
await(t.frames(10));
converter.graphOpen(args, "demo.graph.yml");
await(t.frames(30));
converter.graph("log");
converter.graph("select multiply1");
await(t.frames(30));
converter.graph("reroute lerp1.color output1.color 680 260");
converter.graph("add graph/send 480 40");
converter.graph("add graph/receive 320 360");
converter.graph("link multiply1.result send1.in");
converter.graph("set send1 name mask");
converter.graph("set receive1 name mask");
converter.graph("link receive1.out lerp1.t");
converter.graph("add math/constant 900 600");
converter.graph("log");
await(t.frames(5));
converter.graph("select color1 color2");
converter.graph("frame Colors");
converter.graph("collapse color2");
converter.graph("hide lerp1");
converter.graph("comment output1 The final color");
converter.graph("straighten output1");
converter.graph("upstream lerp1");
converter.graph("downstream checker1");
converter.graph("find final");
converter.graph("unused");
converter.graph("log");
converter.graphSave(args, "tidy.graph.yml");
await(t.frames(10));
converter.graphOpen(args, "tidy.graph.yml");
await(t.frames(30));
converter.graph("log");
converter.graph("select");
await(t.frames(30));
await(t.mouseClickAt("*//graph-canvas", "node color1", "right"));
await(t.clickItem("*", "Collapse"));
await(t.frames(5));
converter.graph("describe color1");
await(t.mouseClickAt("*//graph-canvas", "node lerp1", "right"));
await(t.clickItem("*", "Comment..."));
await(t.typeItem("*", "##comment", "Mixes the colors", true));
await(t.frames(5));
converter.graph("describe lerp1");
await(t.mouseClickAt("*//graph-canvas", "frame frame1", "right"));
await(t.clickItem("*", "Edit..."));
await(t.typeItem("*", "##frame", "Base colors", true));
await(t.frames(5));
converter.graph("describe frame1");
await(t.mouseDragAt("*//graph-canvas", "frame frame1", "at 296 -40"));
await(t.frames(5));
converter.graph("describe frame1");
await(t.mouseMoveTo("*//graph-canvas", "at 300 560"));
await(t.keyDown("a"));
await(t.mouseClickAt("*//graph-canvas", "at 300 560"));
await(t.keyUp("a"));
await(t.frames(5));
converter.graph("describe add1");
await(t.mouseMoveTo("*//graph-canvas", "node add1"));
await(t.waitForTooltip("Input a isn't linked"));
converter.log("Graph tooltip shown");
await(t.mouseDoubleClickAt("*//graph-canvas", "link color1.color lerp1.a"));
await(t.frames(5));
converter.graph("log");
await(t.mouseMoveTo("*//graph-canvas", "at 300 400"));
await(t.key("ctrl+f"));
await(t.typeItem("*", "##find", "Output", true));
await(t.frames(5));
converter.graph("describe output1");
await(t.mouseClickAt("*//graph-canvas", "minimap 0.1 0.1"));
await(t.frames(5));
converter.graph("log");
converter.log("Graph checked");
